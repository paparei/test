# GGSel API
GGSEL_SELLER_ID=1234567
GGSEL_API_KEY=your_api_key_here

# Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_GROUP_ID=-1001234567890

# Optional
POLL_INTERVAL=15
CHAT_CHECK_INTERVAL=40
REVIEW_CHECK_INTERVAL=120
TOPIC_SYNC_INTERVAL=3600
AUTO_UPDATE=false
UPDATE_REPOSITORY=paparei/test

# Docker logging: stdout-only is recommended (Docker handles log rotation).
LOG_TO_FILE=false
# If enabled, mount the containing directory rather than the individual file.
# LOG_FILE_PATH=/app/data/ggsel_bot.log

# Optional alternative to Docker Compose env_file. Mount a secret file at this
# path and provide ENV_FILE as a container environment variable.
# ENV_FILE=/run/secrets/ggsel.env

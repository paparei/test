# GGSel API
GGSEL_SELLER_ID=1234567
GGSEL_API_KEY=your_api_key_here
# Optional public-V2 key for offer reads and guarded price writes.
GGSEL_V2_API_KEY=
# Server-side kill switch for any real V2 price PATCH. Keep false unless live
# repricing is intended; Telegram confirmation is still separately required.
GGSEL_V2_PRICE_WRITE_ENABLED=false

# Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_GROUP_ID=-1001234567890

# Optional
POLL_INTERVAL=15
CHAT_CHECK_INTERVAL=40
REVIEW_CHECK_INTERVAL=120
TOPIC_SYNC_INTERVAL=3600
CHAT_SWEEP_BATCH_SIZE=25
GGSEL_CONNECT_TIMEOUT=5
GGSEL_READ_TIMEOUT=30
AUTO_UPDATE=false
UPDATE_REPOSITORY=paparei/test

# Dry-run only reports proposals. Live approval is persisted only after Telegram
# confirmation; this deployment guard must remain false.
REPRICING_DRY_RUN=false
REPRICING_LIVE_ENABLED=false
# Map public GGSEL offer IDs to desired net USD amounts. These IDs are the
# explicit runtime write allowlist.
REPRICING_TARGETS_USD={}
REPRICING_FEE_PERCENT=0
REPRICING_FIXED_RUB=0
REPRICING_MAX_CHANGE_PERCENT=15

# Docker logging: stdout-only is recommended (Docker handles log rotation).
LOG_TO_FILE=false
# If enabled, mount the containing directory rather than the individual file.
# LOG_FILE_PATH=/app/data/ggsel_bot.log

# Optional alternative to Docker Compose env_file. Mount a secret file at this
# path and provide ENV_FILE as a container environment variable.
# ENV_FILE=/run/secrets/ggsel.env
